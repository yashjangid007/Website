rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "yashjangid.2729@gmail.com" ||
        (request.auth.token.email != "family-vault@yashjangid.com" &&
         exists(/databases/$(database)/documents/vault_access/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/vault_access/$(request.auth.token.email)).data.approved == true)
      );
    }

    // Lock EmailJS credentials to Admin ONLY
    match /site_config/emailjs { allow read, write: if isAdmin(); }

    // Public portfolio configuration & pages
    match /site_config/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /site_content/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /graphics/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /lors/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /mun_events/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /music/{doc} { allow read: if true; allow write: if isAdmin(); }
    
    // Public Contact Form & Private Pings / 11:11 Wishes
    match /inbox_messages/{doc} { allow create: if true; allow read, update, delete: if isAdmin(); }
    
    // Private Family Vault & Hidden Secret Hub Collections
    match /family/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /special_gifts/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /special_programs/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }

    // 11:11 Sanctuary Collections
    match /special_config/next_date { allow read, write: if request.auth != null; }
    match /special_config/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /special_dates/{doc} { allow read, create: if request.auth != null; allow update, delete: if isAdmin(); }
    match /special_stars/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /special_open_when/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /special_1111/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    
    // System Audit Logs & Personnel Clearance
    match /vault_logs/{doc} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /vault_access/{email} {
      allow read: if true;
      allow create: if request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }
  }
}
